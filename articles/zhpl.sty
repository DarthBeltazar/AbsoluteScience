\newtheorem{theorem}{Теорема}
\newtheorem{definition}{Определение}

% ======================================================================
%  Тёмный вариант: всё оформление собрано в одном условном блоке.
%  Перекрашиваются только «оформительские» слои — фон страницы, текст,
%  оси/подписи/сетка графиков, рамки таблиц, три цветных бокса.
%  Цвета серий на графиках (blue/red/green) не трогаются.
% ======================================================================
\ifzhpl@dark
  \definecolor{zhplBg}{HTML}{1C1A15}
  \definecolor{zhplFg}{HTML}{EAE3D2}
  \definecolor{zhplMuted}{HTML}{B3A88F}
  \definecolor{zhplRule}{HTML}{5A5344}

  % Штампы \zhplbadges и их аналоги, захардкоженные в статьях, красят ТЕКСТ
  % явным \color{red!70!black}/\color{blue!60!black} — тёмным по замыслу для
  % светлой заливки. После переопределения white заливка сама стала тёмной,
  % и этот текст на ней сливался бы. Даём светлые версии тех же цветов;
  % статьи выбирают их через \zhplbadgecolor{светлый-вариант}{тёмный-вариант}.
  \definecolor{zhplBadgeRed}{HTML}{FF8A75}
  \definecolor{zhplBadgeBlue}{HTML}{8AB4F8}

  % Цвета трёх боксов: тёмная заливка, светлая рамка, явный светлый текст
  % (тинты yellow!10/gray!6/blue!4 на тёмном фоне нечитаемы). Выражения
  % black!NN, а не именованный цвет — так надёжнее в \colorbox.
  \newcommand{\zhplbox@frame}{zhplMuted}
  \newcommand{\zhplbox@hi}{black!88}
  \newcommand{\zhplbox@rev}{black!88}
  \newcommand{\zhplbox@sig}{black!88}
  \newcommand{\zhplbox@fg}{\color{zhplFg}}

  \pagecolor{zhplBg}
  % Цвет текста по умолчанию + \normalcolor (minipage/tabular возвращают текст
  % к \normalcolor через \@parboxrestore). Хук идёт после хука xcolor.
  % Плюс: перекрываем \fcolorbox — три цветных бокса в статьях всё ещё заданы
  % инлайн как \fcolorbox{black}{yellow!10}{…}; в тёмной теме принудительно
  % делаем заливку тёмной, рамку — светлой (тинты на тёмном фоне нечитаемы).
  \AtBeginDocument{%
    \color{zhplFg}%
    \def\normalcolor{\color{zhplFg}}%
    \let\zhpl@orig@fcolorbox\fcolorbox
    \renewcommand\fcolorbox[3]{\zhpl@orig@fcolorbox{zhplMuted}{black!88}{{\color{zhplFg}#3}}}%
  }

  \renewcommand{\headrule}{\hbox to\headwidth{\color{zhplRule}%
    \leaders\hrule height \headrulewidth\hfill}}

  \pgfplotsset{
    every axis/.append style={
      axis line style={zhplMuted},
      tick style={zhplMuted},
      label style={zhplFg},
      tick label style={zhplFg},
      title style={zhplFg},
      legend style={fill=zhplBg,draw=zhplRule,text=zhplFg},
      grid style={zhplRule},
    },
  }
  \tikzset{
    every picture/.append style={execute at begin picture={\color{zhplFg}}},
    every node/.append style={text=zhplFg},
  }
\else
  \newcommand{\zhplbox@frame}{black}
  \newcommand{\zhplbox@hi}{yellow!10}
  \newcommand{\zhplbox@rev}{gray!6}
  \newcommand{\zhplbox@sig}{blue!4}
  \newcommand{\zhplbox@fg}{}
\fi

% ---------- Титульный аппарат ----------

% Стандартный блок авторов (одинаков во всех статьях журнала).
\newcommand{\zhplauthors}{%
  Роман Георгиевич Александров, Клод Соннет Антропикович\\[4pt]
  \normalsize Институт Прикладной Метафизики\\ \small Кафедра тензорного анализа межличностных отношений}

% \zhplsetup{<номер выпуска>}{<DOI>} — колонтитулы и \date.
% Пример: \zhplsetup{2}{10.9999/жпл.2026.0002}
\newcommand{\zhplsetup}[2]{%
  \pagestyle{fancy}%
  \fancyhf{}%
  \fancyhead[L]{\small Александров, Антропикович}%
  \fancyhead[R]{\small Журнал Прикладной Лженауки, 1(#1), 2026}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \fancyfoot[C]{\small\thepage}%
  \fancyfoot[R]{\small DOI: #2}%
  \date{\small Журнал Прикладной Лженауки, том 1, № #1 \\ Получено: недавно \quad Принято к печати: почти сразу}%
}

% Два повёрнутых штампа под \maketitle.
\newcommand{\zhplbadges}{%
  \begin{center}
  \begin{tikzpicture}
  \node[draw=red!70!black,very thick,rounded corners,rotate=-6,fill=red!5,inner sep=5pt] (badge1) {\color{red!70!black}\bfseries ПРОРЫВНОЕ ИССЛЕДОВАНИЕ};
  \node[draw=blue!60!black,very thick,rounded corners,rotate=4,fill=blue!5,inner sep=5pt,right=1.0cm of badge1] (badge2) {\color{blue!60!black}\bfseries IMPACT FACTOR: $\infty$};
  \end{tikzpicture}
  \end{center}%
}

% \zhplciteas{Александров Р.\,Г., … DOI: 10.9999/жпл.20XX.000N}
\newcommand{\zhplciteas}[1]{%
  \begin{center}
  \small\textit{Как цитировать:} #1
  \end{center}%
}

% \zhplgraphicabstract{<тело tikzpicture>}{<текст подписи>}
\newcommand{\zhplgraphicabstract}[2]{%
  \smallskip
  \begin{figure}[h!]
  \centering
  #1
  \vspace{-6pt}
  \caption*{\small\textbf{Графический реферат.} #2}
  \end{figure}
  \vspace{-10pt}%
}

% ---------- Три цветных бокса ----------
% Содержимое собирается в lrbox и лишь затем заливается — так \fcolorbox/\colorbox
% не навязывают содержимому \normalcolor. Заливка и рамка рисуются вручную
% (\zhpl@framed), чтобы не зависеть от разбора аргументов \fcolorbox.
\newsavebox{\zhpl@boxbuf}

% \zhpl@framed{<цвет рамки>}{<цвет заливки>}{<бокс-контент>}
\newcommand{\zhpl@framed}[3]{%
  \par\noindent
  \setlength{\fboxsep}{6pt}%
  {\color{#1}\fbox{\colorbox{#2}{#3}}}%
  \par}

\newenvironment{zhplhighlights}
  {\begin{lrbox}{\zhpl@boxbuf}\begin{minipage}{0.94\linewidth}%
   \zhplbox@fg\vspace{1pt}\small\textbf{Основные результаты}\par}
  {\vspace{-6pt}\end{minipage}\end{lrbox}%
   \zhpl@framed{\zhplbox@frame}{\zhplbox@hi}{\usebox{\zhpl@boxbuf}}}

\newenvironment{zhplreviews}
  {\begin{lrbox}{\zhpl@boxbuf}\begin{minipage}{0.94\linewidth}%
   \zhplbox@fg\small\textit{Из отзывов рецензентов:}\\}
  {\end{minipage}\end{lrbox}%
   \vspace{4pt}\zhpl@framed{\zhplbox@frame}{\zhplbox@rev}{\usebox{\zhpl@boxbuf}}}

\newenvironment{zhplsignificance}
  {\begin{lrbox}{\zhpl@boxbuf}\begin{minipage}{0.94\linewidth}%
   \zhplbox@fg\textbf{Значимость исследования.} }
  {\end{minipage}\end{lrbox}%
   \vspace{10pt}\zhpl@framed{\zhplbox@frame}{\zhplbox@sig}{\usebox{\zhpl@boxbuf}}\vspace{6pt}}

\endinput
