% zhpl.sty — общий стиль «Журнала Прикладной Лженауки»
%
% Подключение:  \usepackage{zhpl}          — обычный (светлый) вариант
%               \usepackage[dark]{zhpl}     — тёмный вариант для чтения на сайте
% Требует компиляции через XeLaTeX (см. articles/.latexmkrc).
%
% Здесь собрано всё, что руководство для авторов (guide/…guide.md, §3) фиксирует
% как неизменное: преамбула, окружения теорем и «мебель» титульного блока
% (штампы, «Как цитировать», графический реферат, три цветных бокса).
% Научный текст статьи в шаблон не входит.
%
% Тёмный вариант обычно собирается не напрямую, а через тонкую обёртку
% <slug>.dark.tex (\PassOptionsToPackage{dark}{zhpl} + \input{<slug>}).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{zhpl}[2026/09/07 Zhurnal Prikladnoy Lzhenauki style]

\newif\ifzhpl@dark
\DeclareOption{dark}{\zhpl@darktrue}
\DeclareOption*{}
\ProcessOptions\relax

% \zhplbadgecolor{<цвет для светлого варианта>}{<цвет для тёмного варианта>}
% Точечный выбор темы прямо в статье — для мест, которые red!70!black-стилем
% красят текст под светлую заливку и не могут просто взять zhplFg. См. ниже
% (zhplBadgeRed/zhplBadgeBlue определены только в тёмном варианте).
\newcommand{\zhplbadgecolor}[2]{\ifzhpl@dark #2\else #1\fi}

% \zhpldark{<colorspec>} — для инлайн-заливок диаграмм статьи вида
% fill=\zhpldark{blue!5}. В xcolor запись "цвет!N" без второго цвета
% означает N% цвета + (100-N)% БЕЛОГО (истинной точки белого модели, её
% нельзя переопределить через \definecolor{white}{...} — проверено, не
% работает). Дописывая "!black" к тому же выражению, получаем ту же
% пропорцию, но смешанную с чёрным: "blue!5!black" = 5% синего + 95%
% чёрного — то есть тёмный аналог исходной бледной заливки без подбора
% цвета вручную для каждой диаграммы.
\newcommand{\zhpldark}[1]{\ifzhpl@dark #1!black\else #1\fi}

